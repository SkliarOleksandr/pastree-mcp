# Questions for tests\bench.ps1 over tests\fixtures\group - a check that the
# harness runs, not a measurement (five units say nothing about cost).
#
#   powershell -File tests\bench.ps1 -Project tests\fixtures\group\Fixture.groupproj -Bench tests\fixture.bench
#
# Format:
#   == <id> | <the question, as an agent would be asked it>
#   call <tool> <json>          the pastree-mcp call that answers it (one)
#   also <tool> <json>          a call to the OTHER tools that the one above
#                               replaces - any number; their tokens are summed
#                               (`callers` against `references` per level)
#   grep <regex>                what an agent without the server would grep,
#                               case-insensitive, over the group's sources
#   grep-in <path> <regex>      the same over the files under one path
#   grep-dfm <regex>            the same over the sources and the text form
#                               files (.dfm, .fmx) together, one call - a grep
#                               with no file filter; binary form files are
#                               skipped, as ripgrep skips them
#   descendants <class>         grep for `= class(<names>` level by level from
#                               <class>, every name of a level in one call
#   read <file> [<from> <count>]  a file (or lines of one) it would read, 2000
#                               lines per call as Claude Code's Read
# Any number of grep / grep-in / descendants / read lines; paths are relative
# to the group directory.
# The baseline is the first thing a competent agent would try, not a straw man:
# the qualified name when the call site would carry one, the plain name when it
# would not.

== refs-area | Where is TShape.Area used?
call references {"symbol":"TShape.Area"}
grep \bArea\b

== creations-circle | Where are TCircle objects created?
call related {"relation":"creations", "symbol":"TCircle"}
grep TCircle\.Create\b

== descendants-shape | Which classes derive from TShape, directly or not?
call related {"relation":"descendants", "symbol":"uShapes.TShape"}
descendants TShape

== outline-shapes | What is in uShapes?
call outline {"file":"Shared\\uShapes.pas"}
read Shared\uShapes.pas

== callers-circle-area | Who calls TCircle.Area, and who calls those?
call callers {"symbol":"TCircle.Area", "depth":2}
also related {"relation":"overrides", "symbol":"TCircle.Area"}
also references {"symbol":"TCircle.Area"}
also references {"symbol":"TShape.Area"}
also references {"symbol":"IShape.Area"}
also references {"symbol":"RunA"}
also references {"symbol":"TBigCircle.Area"}
also references {"symbol":"TotalArea"}
grep \bArea\b

== source-circle-area | Show TCircle.Area's implementation.
call source {"symbol":"TCircle.Area"}
grep function\s+TCircle\.Area\b
read Shared\uShapes.pas 53 4

== callees-runa | What does RunA call?
call callees {"symbol":"RunA"}
also source {"symbol":"RunA"}
also related {"relation":"overrides", "symbol":"TShape.Area"}
read AppA\uAppA.pas 15 12

== impact-circle-area | What does a change to TCircle.Area reach, and which projects do I build?
call impact {"symbol":"TCircle.Area"}
also callers {"symbol":"TCircle.Area"}
also related {"relation":"overrides", "symbol":"TCircle.Area"}
grep \bArea\b

== members-derived | What can TDerived's methods use, inherited members included?
call members {"symbol":"TDerived"}
also outline {"file":"AppA\\uMembers.pas", "owner":"TDerived"}
also outline {"file":"AppA\\uMembers.pas", "owner":"TBase"}
grep \b(TDerived|TBase)\s*=\s*class\b
read AppA\uMembers.pas 15 25

# ---- forms (SPEC 9.5) ----------------------------------------------------------
# What AppF's .dfm files bind by name, which no search of the Pascal sources
# sees. The calls are the ones that answer once the server reads forms - `form`
# is a tool still to be built; until then their answers are the gap.

== forms-refs-handler | Where is TfrmMain.btnSaveClick used, the forms included?
call references {"symbol":"TfrmMain.btnSaveClick"}
grep-dfm \bbtnSaveClick\b

== forms-callers-handler | What runs TfrmMain.btnSaveClick? No code calls it.
call callers {"symbol":"TfrmMain.btnSaveClick"}
grep-dfm \bbtnSaveClick\b

== forms-refs-component | Where is the TfrmMain.edtName component used?
call references {"symbol":"TfrmMain.edtName"}
grep-dfm \bedtName\b

== forms-refs-frame | Where is the TfraName frame used, placed inline included?
call references {"symbol":"TfraName"}
grep-dfm \bTfraName\b

== forms-refs-module | What names the data module's pmActions menu?
call references {"symbol":"TdmData.pmActions"}
grep-dfm \bpmActions\b

== forms-refs-binary | Where is TfrmBinary.btnBinaryClick bound? Its form file is binary.
call references {"symbol":"TfrmBinary.btnBinaryClick"}
grep-dfm \bbtnBinaryClick\b

== forms-impact-handler | What must change with TfrmMain.btnSaveClick renamed?
call impact {"symbol":"TfrmMain.btnSaveClick"}
grep-dfm \bbtnSaveClick\b

== forms-form-main | What does frmMain contain, and which method does each component run?
call form {"file":"AppF\\uMainForm.pas"}
also outline {"file":"AppF\\uMainForm.pas", "owner":"TfrmMain"}
read AppF\uMainForm.dfm
read AppF\uFrame.dfm

== forms-form-child | What does frmChild contain - what it inherits included?
call form {"file":"AppF\\uChildForm.pas"}
also outline {"file":"AppF\\uChildForm.pas", "owner":"TfrmChild"}
read AppF\uChildForm.dfm
read AppF\uMainForm.dfm

== change-area | TShape.Area is to take a parameter: which lines must change with it?
call change_plan {"symbol":"TShape.Area"}
also definition {"symbol":"TShape.Area"}
also related {"symbol":"TShape.Area", "relation":"overrides"}
also related {"symbol":"IShape.Area", "relation":"implementations"}
also callers {"symbol":"TShape.Area"}
also callers {"symbol":"TCircle.Area"}
also callers {"symbol":"TSquare.Area"}
also callers {"symbol":"TBigCircle.Area"}
grep \bArea\b

== change-handler | Can TfrmMain.btnSaveClick take a second parameter?
call change_plan {"symbol":"TfrmMain.btnSaveClick"}
also definition {"symbol":"TfrmMain.btnSaveClick"}
also callers {"symbol":"TfrmMain.btnSaveClick"}
grep-dfm \bbtnSaveClick\b

== change-getter | TShapeBox.GetItem is to take an index: what else changes?
call change_plan {"symbol":"TShapeBox.GetItem"}
also definition {"symbol":"TShapeBox.GetItem"}
also callers {"symbol":"TShapeBox.GetItem"}
grep \b(GetItem|Item)\b
