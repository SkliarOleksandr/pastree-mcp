# Questions for tests\bench.ps1 over tests\fixtures\group - a check that the
# harness runs, not a measurement (five units say nothing about cost).
#
#   powershell -File tests\bench.ps1 -Project tests\fixtures\group\Fixture.groupproj -Bench tests\fixture.bench
#
# Format:
#   == <id> | <the question, as an agent would be asked it>
#   call <tool> <json>          the pastree-mcp call that answers it (one)
#   also <tool> <json>          a call to the OTHER tools that the one above
#                               replaces - any number; their tokens are summed
#                               (`callers` against `references` per level)
#   grep <regex>                what an agent without the server would grep,
#                               case-insensitive, over the group's sources
#   grep-in <path> <regex>      the same over the files under one path
#   descendants <class>         grep for `= class(<names>` level by level from
#                               <class>, every name of a level in one call
#   read <file> [<from> <count>]  a file (or lines of one) it would read, 2000
#                               lines per call as Claude Code's Read
# Any number of grep / grep-in / descendants / read lines; paths are relative
# to the group directory.
# The baseline is the first thing a competent agent would try, not a straw man:
# the qualified name when the call site would carry one, the plain name when it
# would not.

== refs-area | Where is TShape.Area used?
call references {"symbol":"TShape.Area"}
grep \bArea\b

== creations-circle | Where are TCircle objects created?
call related {"relation":"creations", "symbol":"TCircle"}
grep TCircle\.Create\b

== descendants-shape | Which classes derive from TShape, directly or not?
call related {"relation":"descendants", "symbol":"TShape"}
descendants TShape

== outline-shapes | What is in uShapes?
call outline {"file":"Shared\\uShapes.pas"}
read Shared\uShapes.pas

== callers-circle-area | Who calls TCircle.Area, and who calls those?
call callers {"symbol":"TCircle.Area", "depth":2}
also related {"relation":"overrides", "symbol":"TCircle.Area"}
also references {"symbol":"TCircle.Area"}
also references {"symbol":"TShape.Area"}
also references {"symbol":"IShape.Area"}
also references {"symbol":"RunA"}
also references {"symbol":"TBigCircle.Area"}
also references {"symbol":"TotalArea"}
grep \bArea\b

== source-circle-area | Show TCircle.Area's implementation.
call source {"symbol":"TCircle.Area"}
grep function\s+TCircle\.Area\b
read Shared\uShapes.pas 53 4

== callees-runa | What does RunA call?
call callees {"symbol":"RunA"}
also source {"symbol":"RunA"}
also related {"relation":"overrides", "symbol":"TShape.Area"}
read AppA\uAppA.pas 15 12

== impact-circle-area | What does a change to TCircle.Area reach, and which projects do I build?
call impact {"symbol":"TCircle.Area"}
also callers {"symbol":"TCircle.Area"}
also related {"relation":"overrides", "symbol":"TCircle.Area"}
grep \bArea\b

== members-derived | What can TDerived's methods use, inherited members included?
call members {"symbol":"TDerived"}
also outline {"file":"AppA\\uMembers.pas", "owner":"TDerived"}
also outline {"file":"AppA\\uMembers.pas", "owner":"TBase"}
grep \b(TDerived|TBase)\s*=\s*class\b
read AppA\uMembers.pas 15 25
