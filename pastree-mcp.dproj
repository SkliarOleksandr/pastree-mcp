<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{BB8F8A8C-0DBC-4546-B574-A6644DF676F0}</ProjectGuid>
        <MainSource>pastree-mcp.dpr</MainSource>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <ProjectName Condition="'$(ProjectName)'==''">pastree-mcp</ProjectName>
        <TargetedPlatforms>2</TargetedPlatforms>
        <AppType>Console</AppType>
        <FrameworkType>None</FrameworkType>
        <ProjectVersion>20.3</ProjectVersion>
        <Platform Condition="'$(Platform)'==''">Win64</Platform>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Base)'=='true') or '$(Base_Win64)'!=''">
        <Base_Win64>true</Base_Win64>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_E>false</DCC_E>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_ImageBase>00400000</DCC_ImageBase>
        <SanitizedProjectName>pastree_mcp</SanitizedProjectName>
        <VerInfo_IncludeVerInfo>false</VerInfo_IncludeVerInfo>
        <VerInfo_Locale>1033</VerInfo_Locale>
        <!-- build.bat is the reference build (it also runs the smoke test);
             this project builds the same exe by hand - in the IDE or with
             msbuild - and is what the server reads to index this repository
             (.mcp.json). Keep the namespaces, the search path and the output
             directories in step with build.bat. -->
        <DCC_Namespace>System;System.Win;Winapi;Data;Xml;$(DCC_Namespace)</DCC_Namespace>
        <!-- The exe in out\, the .dcu files per compiler version: they are not
             portable between versions, and never go beside a source. The
             version is the name of the $(BDS) directory (37.0):
             $(ProductVersion) is only defined by the targets imported at the
             end of this file, so it is still empty here. -->
        <DCC_ExeOutput>out</DCC_ExeOutput>
        <DCC_DcuOutput>out\dcu\$([System.IO.Path]::GetFileName($(BDS)))\win64</DCC_DcuOutput>
        <!-- Every build a full one, as build.bat's -B: otherwise a .dcu on the
             search path that is newer than its source - the sibling PasTree
             checkout has had some - is linked as it is, compiled with
             whatever options made it. -->
        <DCC_BuildAllUnits>true</DCC_BuildAllUnits>
        <!-- PasTree is linked from its sibling checkout, not copied here -
             which is also why this project is Win64 only. -->
        <DCC_UnitSearchPath>..\object-pascal-tree\source;source;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_IncludePath>..\object-pascal-tree\source;$(DCC_IncludePath)</DCC_IncludePath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win64)'!=''">
        <BT_BuildType>Debug</BT_BuildType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_RangeChecking>true</DCC_RangeChecking>
        <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="source\PasMcp.Version.pas"/>
        <DCCReference Include="source\PasMcp.Log.pas"/>
        <DCCReference Include="source\PasMcp.Transport.pas"/>
        <DCCReference Include="source\PasMcp.Studio.pas"/>
        <DCCReference Include="source\PasMcp.GroupProj.pas"/>
        <DCCReference Include="source\PasMcp.Workspace.pas"/>
        <DCCReference Include="source\PasMcp.Tools.pas"/>
        <DCCReference Include="source\PasMcp.Server.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">pastree-mcp.dpr</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">False</Platform>
                <Platform value="Win64">True</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
</Project>
